{
  "name": "memran/marwa-logger",
  "description": "PSR-3 JSON logger with sensitive-data filtering and pluggable storage (file; Kafka/DB-ready).",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Marwa\\Logger\\": "src/"
    }
  },
  "require": {
    "php": ">=8.1",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5.62",
    "phpstan/phpstan": "^2.1"
  },
  "scripts": {
    "analyze": "vendor/bin/phpstan analyse --configuration phpstan.neon --no-progress --debug",
    "test": "vendor/bin/phpunit --configuration phpunit.xml",
    "lint": [
      "php -l src/Logger.php",
      "php -l src/SimpleLogger.php",
      "php -l src/Storage/FileSink.php",
      "php -l src/Storage/StorageFactory.php",
      "php -l src/Support/SensitiveDataFilter.php",
      "php -l src/Contracts/SinkInterface.php",
      "php -l tests/SimpleLoggerTest.php",
      "php -l tests/FileSinkTest.php"
    ],
    "check": [
      "@lint",
      "@analyze",
      "@test"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
